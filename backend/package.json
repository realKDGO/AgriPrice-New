{
  "name": "agriprice-backend",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "jobs:storage": "node --env-file=.env src/jobs/storageCleanup.js",
    "jobs:forecasts": "node --env-file=.env src/jobs/generateForecasts.js",
    "jobs:retention": "node --env-file=.env src/jobs/retention.js",
    "bootstrap:admin": "node --env-file=.env src/jobs/bootstrapAdmin.js",
    "test:integration": "node --test tests/integration.test.js"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "prisma": "6.12.0",
    "@supabase/supabase-js": "2.57.4",
    "express": "5.1.0",
    "zod": "3.25.76",
    "jsonwebtoken": "9.0.2",
    "bcrypt": "6.0.0",
    "helmet": "8.1.0",
    "cors": "2.8.5",
    "morgan": "1.12.0",
    "express-rate-limit": "8.7.0",
    "cookie-parser": "1.4.7",
    "multer": "2.3.0",
    "sharp": "0.35.4",
    "swagger-ui-express": "5.0.1",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.2"
  },
  "devDependencies": {
    "supertest": "7.1.4"
  }
}
