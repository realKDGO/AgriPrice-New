# Local presentation environment only. Never use these values in production.
DATABASE_URL=postgresql://postgres:CHANGE_YOUR_POSTGRES_PASSWORD@localhost:5432/agriprice_presentation?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_YOUR_POSTGRES_PASSWORD@localhost:5432/agriprice_presentation?schema=public
JWT_ACCESS_SECRET=local-presentation-access-secret-change-before-sharing-2026
JWT_REFRESH_SECRET=local-presentation-refresh-secret-change-before-sharing-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:4173
PORT=5000
NODE_ENV=development
COOKIE_SAME_SITE=lax
TRUST_PROXY=0

# Local crop-image storage. Supabase is not used by this presentation copy.
LOCAL_STORAGE_MODE=true
LOCAL_STORAGE_DIR=uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:5000/uploads
ALLOW_LAN_ORIGINS=true
EMAIL_DOMAIN_CHECK_MODE=dns_or_common
SUPABASE_CROP_BUCKET=crop-images

# Repeatable dummy presentation data.
SEED_SAMPLE_DATA=true
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=AgriPriceDemo2026!
SEED_MAO_EMAIL=mao@example.org
SEED_MAO_PASSWORD=AgriPriceDemo2026!
SEED_FARMER_EMAIL=farmer@example.org
SEED_FARMER_PASSWORD=AgriPriceDemo2026!
